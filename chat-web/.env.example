# =====================================================================================================
# Goppo Chat — PythonAnywhere environment file.            Copy to  .env  in the project folder (same level as wsgi.py / run.py).
# These variables belong to the PythonAnywhere web app ONLY. The Render calling server has its own file:
#   calling-server/.env.example   (never copy Render-only variables here and never put these secrets on Render,
#   except CALLING_HMAC_SECRET, which MUST be identical on both sides).
# Never commit the real .env. Blank value = "use the built-in default" (or "feature off").
# Generate a strong secret:   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================================================


# ---- app ----
APP_NAME=Goppo
APP_ENV=development
SECRET_KEY=
LOG_LEVEL=INFO
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,bn

# ---- database ----
DATABASE_URL=

# ---- sessions & cookies ----
SESSION_LIFETIME_DAYS=14
SESSION_COOKIE_SECURE=0

# ---- admins ----
ADMIN_EMAILS=

# ---- mail / OTP ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_NAME=APP_NAME
MAIL_PROVIDER=smtp
MAIL_API_KEY=
# Mailgun sending domain only
MAIL_API_DOMAIN=
# defaults to MAIL_USERNAME
MAIL_FROM_ADDRESS=
MAIL_TIMEOUT_SECONDS=15
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5
MAIL_DEV_CONSOLE=0
UNVERIFIED_ACCOUNT_TTL_MINUTES=60

# ---- cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MESSAGE_MAX_CHARS=4000
MAX_VOICE_SECONDS=300
CHAT_PAGE_SIZE=30
# None = Werkzeug default
PASSWORD_HASH_METHOD=
CLOUDINARY_FOLDER_AVATARS=goppo/avatars
CLOUDINARY_FOLDER_COVERS=goppo/covers
CLOUDINARY_FOLDER_CHAT_IMAGES=goppo/chat/images
CLOUDINARY_FOLDER_CHAT_VIDEOS=goppo/chat/videos
CLOUDINARY_FOLDER_CHAT_VOICE=goppo/chat/voice
CLOUDINARY_FOLDER_CHAT_FILES=goppo/chat/files
CLOUDINARY_FOLDER_CHAT_OTHER=goppo/chat/other

# ---- upload rules (size in bytes, extensions without dots) ----
MAX_IMAGE_MB=5
MAX_VIDEO_MB=25
MAX_DOCUMENT_MB=10
MAX_VOICE_MB=5
MAX_FILE_MB=10
ALLOWED_IMAGE_EXTENSIONS=jpg,jpeg,png,webp,gif
ALLOWED_VIDEO_EXTENSIONS=mp4,mov,webm
ALLOWED_DOCUMENT_EXTENSIONS=pdf,doc,docx,xls,xlsx,ppt,pptx,txt
ALLOWED_VOICE_EXTENSIONS=webm,ogg,mp3,m4a,wav
ALLOWED_FILE_EXTENSIONS=zip,rar,7z,csv

# ---- real-time ----
REALTIME_MODE=polling
POLL_INTERVAL_ACTIVE_MS=2500
POLL_INTERVAL_IDLE_MS=12000
PRESENCE_TIMEOUT_SECONDS=75
PRESENCE_WRITE_INTERVAL_SECONDS=30
POLL_INTERVAL_CHAT_MAX_MS=5000
POLL_INTERVAL_LIST_MS=5000

# ---- rate limiting ----
RATELIMIT_STORAGE_URI=memory://
TRUSTED_PROXY_COUNT=
LOGIN_ACCOUNT_LIMIT=8 per 15 minutes

# ---- Web Push (VAPID) ----
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# mailto:you@gmail.com (a real address) or https://your-site
VAPID_CONTACT=
# how long a push service keeps it for an offline phone
PUSH_TTL_SECONDS=86400
PUSH_SEND_TIMEOUT_SECONDS=6
PUSH_ACK_MAX_AGE_SECONDS=90000
PUSH_MAX_DEVICES_PER_USER=5
PUSH_ENDPOINT_EXTRA_HOSTS=
PUSH_ENDPOINT_CHECK_DNS=1
PUSH_ANNOUNCEMENT_INLINE_LIMIT=40

# ---- Voice / Video Calling (Render signaling server) ----
# e.g. https://goppo-calling.onrender.com
CALLING_SERVER_URL=
# shared with Render; long random string
CALLING_HMAC_SECRET=
CALLING_WAKE_TIMEOUT_MS=90000
CALLING_HEALTH_POLL_MS=2000
# life of one signed call token
CALLING_TOKEN_TTL_SECONDS=120
# unanswered call becomes "missed"
CALLING_RING_SECONDS=60
# a "connected" call nobody ended
CALLING_MAX_CALL_SECONDS=14400

# ---- Math Class SSO ----
SSO_SHARED_SECRET=
SSO_ENABLED=0
MATH_CLASS_URL=

# ---- Native Android app (Phase 1: device registration only) ----
# 0 closes the /api/devices registration API.
NATIVE_DEVICES_ENABLED=1
# Informational only: GET /api/devices/config now reports whether FCM sending is really configured.
NATIVE_PUSH_DELIVERY=0
NATIVE_MAX_DEVICES_PER_USER=5

# ---- Native Android push: Firebase Cloud Messaging HTTP v1 (Phase 3) ----
# Firebase console > Project settings > Service accounts > Generate new private key. This is a SERVER secret:
# it never goes into the APK or the repository (the APK only gets google-services.json, a different file).
# Set ONE of these. Easiest on PythonAnywhere:  base64 -w0 service-account.json   and paste the result.
FCM_SERVICE_ACCOUNT_B64=
# or the JSON text itself / a file path (chmod 600) instead of the base64 line above:
FCM_SERVICE_ACCOUNT_JSON=
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=
FCM_MESSAGE_PRIORITY=high
FCM_MAX_FAILURES=10
