<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS only. System certificate authorities only; no user-added CAs, no cleartext, no pinning exceptions. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
