<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base theme. Capacitor's BridgeActivity switches to AppTheme.NoActionBar once the splash screen is done. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/goppo_brand</item>
        <item name="colorPrimaryDark">@color/goppo_brand_dark</item>
        <item name="colorAccent">@color/goppo_accent</item>
        <item name="android:windowBackground">@color/goppo_brand</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Launch theme: system splash screen (Android 12+ native, androidx.core:core-splashscreen on older versions). -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/goppo_brand</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
