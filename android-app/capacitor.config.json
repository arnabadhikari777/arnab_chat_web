{
  "appId": "com.goppo.chat",
  "appName": "Goppo Chat",
  "webDir": "www",
  "appendUserAgent": "GoppoAndroid/1.0.0",
  "backgroundColor": "#0b6e78",
  "server": {
    "url": "https://arnabchatweb.pythonanywhere.com",
    "cleartext": false,
    "allowNavigation": [
      "arnabchatweb.pythonanywhere.com"
    ],
    "errorPath": "offline.html"
  },
  "android": {
    "allowMixedContent": false,
    "webContentsDebuggingEnabled": false,
    "captureInput": true,
    "adjustMarginsForEdgeToEdge": "disable",
    "backgroundColor": "#0b6e78"
  }
}
