# Goppo / arnab_chat_web – copy to .env and fill in

APP_NAME=Goppo
APP_ENV=production
SECRET_KEY=                    # python -c "import secrets; print(secrets.token_hex(32))"
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,bn

# Database (SQLite is fine on PythonAnywhere)
# DATABASE_URL=sqlite:////home/yourusername/arnab_chat_web/instance/chat.db

# Admins (your email – register with it to become admin)
ADMIN_EMAILS=you@gmail.com

# Gmail OTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@gmail.com
MAIL_PASSWORD=                 # Gmail App Password
MAIL_FROM_NAME=Goppo
# MAIL_DEV_CONSOLE=1           # local only: print OTP in terminal

# Cloudinary (used for all chat images / videos / voice)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_AVATARS=goppo/avatars
CLOUDINARY_FOLDER_COVERS=goppo/covers
CLOUDINARY_FOLDER_CHAT_IMAGES=goppo/chat/images
CLOUDINARY_FOLDER_CHAT_VIDEOS=goppo/chat/videos
CLOUDINARY_FOLDER_CHAT_VOICE=goppo/chat/voice
CLOUDINARY_FOLDER_CHAT_FILES=goppo/chat/files

# Math Class SSO (must match Math Class .env)
SSO_SHARED_SECRET=             # same long secret as Math Class
SSO_ENABLED=0
MATH_CLASS_URL=https://your-math-class.pythonanywhere.com

# Optional tuning
SESSION_LIFETIME_DAYS=14
MESSAGE_MAX_CHARS=4000
MAX_IMAGE_MB=5
MAX_VIDEO_MB=25
MAX_VOICE_MB=5

# ---- Web Push notifications (ALL THREE are required, otherwise Settings says "not set up on this server") ----
# 1) In the PythonAnywhere Bash console, inside the project folder (venv active):   flask generate-vapid-keys
# 2) Paste the two printed lines here, and put YOUR real email in VAPID_CONTACT (placeholders like example.com are rejected).
# 3) Reload the web app (Web tab -> Reload), then check:   flask push-status
# Keep VAPID_PRIVATE_KEY secret. Generate the pair ONCE: new keys later make every phone re-enable notifications.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:your-real-email@gmail.com
# Optional tuning
# PUSH_TTL_SECONDS=86400              # how long a push service holds a push for a switched-off phone
# PUSH_SEND_TIMEOUT_SECONDS=6
# PUSH_MAX_DEVICES_PER_USER=5
# PUSH_ANNOUNCEMENT_INLINE_LIMIT=40   # announcement pushes sent immediately (everyone still gets the Notice Box entry)
# PUSH_ACK_EXTRA_SECONDS=300          # delivery-acknowledgement token lifetime = PUSH_TTL_SECONDS + this
