# Goppo / arnab_chat_web – copy to .env and fill in

APP_NAME=Goppo
APP_ENV=production
SECRET_KEY=                    # python -c "import secrets; print(secrets.token_hex(32))"
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,bn

# Database (SQLite is fine on PythonAnywhere)
# DATABASE_URL=sqlite:////home/yourusername/arnab_chat_web/instance/chat.db

# Admins (your email – register with it to become admin)
ADMIN_EMAILS=you@gmail.com

# ---- Email / OTP codes ----
# Gmail SMTP (default). Use a Google APP PASSWORD (16 characters; needs 2-Step Verification), never the normal password.
# Port 587 = STARTTLS (recommended). Port 465 = implicit SSL. The code picks the right one from MAIL_PORT.
MAIL_PROVIDER=smtp
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-address@gmail.com
MAIL_PASSWORD=xxxx-xxxx-xxxx-xxxx
MAIL_FROM_NAME=Goppo
# MAIL_FROM_ADDRESS=your-address@gmail.com     # defaults to MAIL_USERNAME; Gmail only allows the account itself or its aliases
MAIL_TIMEOUT_SECONDS=15
# If outgoing SMTP is blocked by your host (PythonAnywhere Free), use an HTTPS provider instead:
# MAIL_PROVIDER=brevo            # sendgrid | mailgun | brevo | resend
# MAIL_API_KEY=your-provider-api-key
# MAIL_API_DOMAIN=mg.example.com # Mailgun only
# MAIL_DEV_CONSOLE=1             # development only: print emails to the console

# OTP rules (defaults shown)
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# Cloudinary (used for all chat images / videos / voice)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER_AVATARS=goppo/avatars
CLOUDINARY_FOLDER_COVERS=goppo/covers
CLOUDINARY_FOLDER_CHAT_IMAGES=goppo/chat/images
CLOUDINARY_FOLDER_CHAT_VIDEOS=goppo/chat/videos
CLOUDINARY_FOLDER_CHAT_VOICE=goppo/chat/voice
CLOUDINARY_FOLDER_CHAT_FILES=goppo/chat/files

# Math Class SSO (must match Math Class .env)
SSO_SHARED_SECRET=             # same long secret as Math Class
SSO_ENABLED=1
MATH_CLASS_URL=https://your-math-class.pythonanywhere.com

# Optional tuning
SESSION_LIFETIME_DAYS=14
MESSAGE_MAX_CHARS=4000
MAX_IMAGE_MB=5
MAX_VIDEO_MB=25
MAX_VOICE_MB=5

# ---- Web Push notifications (ALL THREE are required, otherwise Settings says "not set up on this server") ----
# 1) In the PythonAnywhere Bash console, inside the project folder (venv active):   flask generate-vapid-keys
# 2) Paste the two printed lines here, and put YOUR real email in VAPID_CONTACT (placeholders like example.com are rejected).
# 3) Reload the web app (Web tab -> Reload), then check:   flask push-status
# Keep VAPID_PRIVATE_KEY secret. Generate the pair ONCE: new keys later make every phone re-enable notifications.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_CONTACT=mailto:your-real-email@gmail.com
# Optional tuning
# PUSH_TTL_SECONDS=86400              # how long a push service holds a push for a switched-off phone
# PUSH_SEND_TIMEOUT_SECONDS=6
# PUSH_ACK_MAX_AGE_SECONDS=90000      # device-receipt token lifetime; keep it above PUSH_TTL_SECONDS
# PUSH_MAX_DEVICES_PER_USER=5
# PUSH_ANNOUNCEMENT_INLINE_LIMIT=40   # announcement pushes sent immediately (everyone still gets the Notice Box entry)

# ---- Production (PythonAnywhere) ----
# APP_ENV=production            # turns on secure cookies and HSTS; the site must be served over https
# DATABASE_URL=sqlite:////home/YOUR_USERNAME/arnab_chat_web/instance/chat.db   # four slashes = absolute path
# TRUSTED_PROXY_COUNT=1         # PythonAnywhere sits behind one proxy
# SESSION_COOKIE_SECURE=1

# ---- Mail provider (PythonAnywhere Free usually needs an HTTPS provider instead of Gmail SMTP) ----
# MAIL_PROVIDER=smtp            # smtp | sendgrid | mailgun | brevo | resend
# MAIL_API_KEY=
# MAIL_FROM_ADDRESS=

# ---- Push endpoint safety (SSRF guard) ----
# Only known browser push services are accepted. Add a host here ONLY if a real browser is rejected
# (comma separated, no https://). Never add your own domain.
# PUSH_ENDPOINT_EXTRA_HOSTS=
# PUSH_ENDPOINT_CHECK_DNS=1
