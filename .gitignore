# ============ Secrets (NEVER commit) ============
.env
*.pem
*.key
.secret_key

# ============ Live data (stays on the server) ============
instance/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
backups/
logs/
uploads/notes/*

# ============ Python ============
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
ENV/
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/

# ============ Editors / OS ============
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ============ Temp / leftovers ============
*.log
*.tmp
*.bak
*.orig
*.zip

# test fixture (schema only, zero rows) must be committed
!tests/fixtures/*.db
