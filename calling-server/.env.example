# =====================================================================================================
# Goppo CALLING SERVER — Render environment (set these in the Render dashboard → Environment).
# These variables belong to RENDER ONLY. The PythonAnywhere variables are in chat-web/.env.example.
# CALLING_HMAC_SECRET is the single value that must be IDENTICAL on both platforms.
# Never commit a real .env. Generate secrets with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# =====================================================================================================

# --- required ---
CALLING_HMAC_SECRET=                    # >= 32 chars; same value as CALLING_HMAC_SECRET on PythonAnywhere
ALLOWED_ORIGINS=                        # exact origins, comma separated, e.g. https://YOURNAME.pythonanywhere.com
                                        # local dev may add: http://localhost:5000,http://127.0.0.1:5000  (no wildcards, no paths)

# --- ICE: STUN / TURN ---
STUN_URLS=stun:stun.l.google.com:19302
# TURN is strongly recommended for mobile carrier networks and strict NATs. Provide UDP, TCP and TLS URLs if your provider has them:
TURN_URLS=                              # e.g. turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_SHARED_SECRET=                     # coturn "static-auth-secret": the server derives short-lived credentials from it (preferred)
TURN_CREDENTIAL_TTL_SECONDS=3600
# Only if your TURN provider cannot do shared-secret credentials (not recommended: long-lived, returned to authenticated callers only):
TURN_STATIC_USERNAME=
TURN_STATIC_PASSWORD=

# --- behaviour (defaults are fine) ---
REQUIRE_NATIVE=true                     # keep true in production: the server refuses to start if C/C++/Rust do not verify
RING_TIMEOUT_SECONDS=75                 # callee never connected
RECONNECT_GRACE_SECONDS=20              # a dropped party may return within this time
TOKEN_MAX_AGE_SECONDS=300               # upper bound accepted for a token's lifetime
# PORT is provided by Render automatically; do not set it there.
PORT=8080
